# Opt-in workflow: move to .github/workflows/connectiq-build-test.yml after review.
# This uses a third-party GitHub Action to provision the Garmin SDK.
# SDK action source reviewed at the pinned revision; device provenance still needs review.
# This file is inert here. Keep it outside .github/workflows until CI is approved.
name: Connect IQ build and test (Offline Pro)
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build-and-test:
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        device: [instinct3solar45mm, instinct3amoled45mm, instinct3amoled50mm]
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Install Connect IQ SDK
        uses: DuckSoft/setup-connectiq-actions@3bf05012f67c01a983f6f81cc1823d7afc5dd28c
        with:
          sdk-version: '9.2.0'
          install-devices: 'true'
      - name: Install simulator libraries (Ubuntu 22.04)
        run: |
          sudo apt-get update
          sudo apt-get install -y xvfb xauth dbus-x11 libwebkit2gtk-4.0-37 libsoup2.4-1 libjpeg-turbo8
      - name: Check source defaults and permissions
        run: |
          python3 -I tools/check-secrets.py
          python3 -I tools/check-build.py --properties
      - name: Ephemeral CI signing key
        shell: bash
        run: |
          openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out "$RUNNER_TEMP/ci-key.pem"
          openssl pkcs8 -topk8 -inform PEM -outform DER -in "$RUNNER_TEMP/ci-key.pem" -out "$RUNNER_TEMP/ci-key.der" -nocrypt
      - name: Compile production app (secrets-free)
        shell: bash
        run: |
          monkeyc -f monkey.jungle -d "${{ matrix.device }}" -o "$RUNNER_TEMP/release.prg" -y "$RUNNER_TEMP/ci-key.der" -r
          python3 -I tools/check-build.py "$RUNNER_TEMP/release.prg"
      - name: Compile simulator tests
        shell: bash
        run: |
          monkeyc -f monkey.jungle -d "${{ matrix.device }}" -o "$RUNNER_TEMP/tests.prg" -y "$RUNNER_TEMP/ci-key.der" -t
      - name: Run simulator tests
        shell: bash
        run: bash tools/ci-simulator-tests.sh "$RUNNER_TEMP/tests.prg" "${{ matrix.device }}"
      - name: Remove ephemeral key
        if: always()
        run: rm -f "$RUNNER_TEMP/ci-key.pem" "$RUNNER_TEMP/ci-key.der"
