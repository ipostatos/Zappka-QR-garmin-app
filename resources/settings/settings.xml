<settings>
    <setting propertyKey="@Properties.userId" title="@Strings.UserIdTitle" prompt="@Strings.UserIdPrompt">
        <settingConfig type="alphaNumeric" maxLength="20" errorMessage="@Strings.InvalidValue"/>
    </setting>
    <setting propertyKey="@Properties.secret" title="@Strings.SecretTitle" prompt="@Strings.SecretPrompt">
        <settingConfig type="password" maxLength="128"/>
    </setting>
</settings>
